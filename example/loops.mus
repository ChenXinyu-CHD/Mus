let main = fn() -> i32 {
    var v1 = 0;
    var v2 = 1;

    printf("fibonacci:\n");
    while v1 < 1000000 {
        printf("%d\n", v2);
        var v3 = v1 + v2;
        v1 = v2
        v2 = v3
    }

    printf("square:\n");
    for var i: i64 = 2; i < 1000000; i = i * i
        printf("%ld\n", i);

    printf("fact1:\n");
    var n = 1
    var i = 1
    for ;; {
        if n >= 100000 break;
        printf("%d\n", n);
        n = n * i
        i = i + 1
    }

    printf("fact2:\n");
    n = 1
    i = 1
    loop {
        if n >= 100000 break;
        printf("%d\n", n);
        n = n * i
        i = i + 1
    }

    return 0
}

let printf: fn(&i8, ...) -> i32 @extern
